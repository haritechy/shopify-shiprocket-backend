# =========================================================
# SERVER
# =========================================================
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://your-service.onrender.com

# Protect the Shopify callback URL with a random secret.
# The registration script will create:
# https://shipping.example.com/api/shipping/rates?key=YOUR_SECRET
CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET

# =========================================================
# SHIPROCKET API USER
# Create a Shiprocket API user and place its credentials here.
# Never expose these values in Shopify theme/frontend JavaScript.
# =========================================================
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=REPLACE_WITH_SHIPROCKET_PASSWORD
SHIPROCKET_PICKUP_PINCODE=000000
SHIPROCKET_API_BASE=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_TIMEOUT_MS=5000

# =========================================================
# PACKAGE DEFAULTS
# Shopify carrier request contains item weights but not package dimensions.
# Keep realistic defaults, or later replace with product/metafield logic.
# Units: cm and kg
# =========================================================
PACKAGE_LENGTH_CM=20
PACKAGE_BREADTH_CM=15
PACKAGE_HEIGHT_CM=10
MIN_WEIGHT_KG=0.10

# =========================================================
# SHIPPING PRICE RULES
# Shiprocket returns the courier price; these rules can adjust what customer sees.
# =========================================================
SHIPPING_HANDLING_FEE=0
SHIPPING_MARKUP_PERCENT=0
SHIPPING_MIN_CHARGE=0

# Set 0 to disable free shipping.
FREE_SHIPPING_ABOVE=0
FREE_SHIPPING_LABEL=Free Shipping

# Return only the cheapest rate by default.
# true = return up to MAX_RATES cheapest courier options.
RETURN_MULTIPLE_RATES=false
MAX_RATES=3

# Carrier callback happens before customer selects payment method,
# therefore default rate lookup should normally be prepaid (0).
SHIPROCKET_COD_FLAG=0

# =========================================================
# STORE RULES
# This template assumes Shiprocket INR rates.
# Comma separated allowed destination country codes.
# =========================================================
STORE_CURRENCY=INR
ALLOWED_COUNTRIES=IN

# If Shiprocket fails:
# backup -> HTTP 503 so Shopify can use configured backup rates
# empty  -> HTTP 200 {"rates":[]} so no rate from this carrier is shown
FAIL_MODE=backup

# =========================================================
# SHOPIFY ADMIN API (needed only for scripts/register-carrier.js)
# Give the app write_shipping access.
# =========================================================
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=REPLACE_WITH_SHOPIFY_ADMIN_TOKEN
SHOPIFY_API_VERSION=2026-10
CARRIER_SERVICE_NAME=Shiprocket Live Shipping
